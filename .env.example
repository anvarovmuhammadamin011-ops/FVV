# FVV Andijon backend — muhit o'zgaruvchilari namunasi.
#
# Foydalanish:  cp .env.example .env   va qiymatlarni to'ldiring.
# `.env` avtomatik yuklanadi:
#   - `npm start` / `npm run dev` (node --env-file-if-exists=.env)
#   - pm2 (ecosystem.config.js node_args orqali)
# Eslatma: pm2/shell'da o'rnatilgan o'zgaruvchi `.env`dan ustun turadi.
#
# Haqiqiy qiymatlarni `.env` ga qo'ying (`.env` git'ga qo'shilmaydi).
# Barcha qiymatlar ixtiyoriy — ko'rsatilmasa xavfsiz default ishlatiladi.

# Muhit: development | production (production'da JSON log + info daraja)
NODE_ENV=production

# Tarmoq
PORT=5500
HOST=0.0.0.0

# CORS: '*' yoki aniq origin, masalan https://fvv-andijon.vercel.app
CORS_ORIGIN=*

# Parollar (vergul bilan). Kodda hardcode qilmaslik uchun shu yerda sozlang.
ADMIN_PASSWORDS=111223,123456
WORKER_PASSWORDS=122333,123456

# Resurs chegaralari (DoS himoyasi)
MAX_BODY_BYTES=31457280        # 30MB — so'rov tanasi (base64 rasmlar)
MAX_IMAGE_BYTES=8388608        # 8MB  — bitta rasm
MAX_PHOTOS=12                  # bitta qaydga rasmlar soni

# Sessiya amal qilish muddati (ms). Default: 12 soat
SESSION_TTL_MS=43200000

# So'rov timeout (ms) — slow-loris himoyasi
REQUEST_TIMEOUT_MS=30000

# --- Rasm saqlash (image storage) ---
# local = uploads/ papkasi (default);  s3 = alohida object storage (R2/S3/MinIO)
STORAGE_DRIVER=local

# STORAGE_DRIVER=s3 bo'lganda quyidagilar kerak
# (avval VPS'da: npm install @aws-sdk/client-s3)
S3_BUCKET=fvv-images
S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Rasmlar ochiq ko'rinadigan bazaviy URL (CDN/public domen).
# Berilmasa: <S3_ENDPOINT>/<S3_BUCKET> ishlatiladi.
S3_PUBLIC_BASE=https://cdn.example.com
# Ixtiyoriy
S3_KEY_PREFIX=checks
S3_FORCE_PATH_STYLE=true
# S3_ACL=public-read   # R2 uchun kerak emas (bucket public bo'lsa)
